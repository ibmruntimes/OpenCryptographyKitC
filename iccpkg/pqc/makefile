#OQS_FLAGS = -DOQS_MINIMAL_BUILD="KEM_kyber_768;SIG_dilithium_3;SIG_sphincs_shake_256s_simple" -DOQS_BUILD_ONLY_LIB=ON
#DEFAULT_BUILD_OQS      = cd $(ICC_ROOT)/liboqs; cmake -G "Unix Makefiles" $(OQS_FLAGS) . ; make

.SUFFIXES:
%.mk:
	# no recipe - disabled
Makefile:
	# no recipe - disabled

ICC_ROOT=../..

include $(ICC_ROOT)/iccpkg/muppet.mk
include $(ICC_ROOT)/icc/platforms.mk
include $(ICC_ROOT)/icc/icc_defs.mk
include $(ICC_ROOT)/iccpkg/gsk_crypto.mk

#-I common/aes -I common/rand -I common/sha2 -I common/sha3
DilKyb_CFLAGS_$(OPSYS) = -I $(GSK_SDK) -I . $(PQCINC) $(CFLAGS)

DilKyb_CFLAGS_SUN_X86 := -std=c99 $(DilKyb_CFLAGS_$(OPSYS))
DilKyb_CFLAGS_SUN_AMD64 := -xc99=all $(DilKyb_CFLAGS_$(OPSYS))

DilKyb_CFLAGS=$(DilKyb_CFLAGS_$(OPSYS))

OBJD=o

# LDLIBS is from platforms.mk
SYSLIBS=$(LDLIBS)

TEST_FLAGS=-v -ed raw

all : $(OBJD) kemtest$(EXESUFX) sigtest$(EXESUFX)

jcc_all : $(OBJD) jkemtest$(EXESUFX) jsigtest$(EXESUFX)

ickc_all : $(OBJD) ikemtest$(EXESUFX) isigtest$(EXESUFX)

t_kemtest:
	$(GSK_SETUP) ; ./kemtest
t_kemtest_v:
	$(GSK_SETUP) ; ./kemtest -v
t_k1024:
ifeq ($(strip $(IS_FIPS)),)
	$(GSK_SETUP) ; ./kemtest -alg "Kyber_1024"
else
	echo Kyber_1024 not tested on FIPS
endif
t_k768:
	$(GSK_SETUP) ; ./kemtest -alg "MLKEM768"
	$(GSK_SETUP) ; ./kemtest -alg "MLKEM768" -v -ed pkcs
t_ktcb:
	$(GSK_SETUP) ; ./kemtest -tcb

t_sigtest_v:
	$(GSK_SETUP) ; ./sigtest -v
t_srsa:
	$(GSK_SETUP) ; ./sigtest -alg "rsaEncryption"
t_srsa_tcb:
	$(GSK_SETUP) ; ./sigtest -tcb -alg "rsaEncryption"
# FIPS 8.6 may show an error here
t_srsa_fips:
	$(GSK_SETUP) ; ./sigtest -fips -fcb -alg "rsaEncryption"
t_sdsa44:
	$(GSK_SETUP) ; ./sigtest -alg "ML_DSA_44" -l 8000
	$(GSK_SETUP) ; ./sigtest -alg "ML_DSA_44" -l 8000 -v -ed pkcs
t_sdsa65:
ifeq ($(strip $(IS_FIPS)),)
	$(GSK_SETUP) ; ./sigtest -alg "ML_DSA_65" -h "SHA256"
	$(GSK_SETUP) ; ./sigtest -alg "MLDSA65" -l 80000
else
	echo ML_DSA_65 not tested on FIPS
endif
t_sshake128s:
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHAKE_128s" -l 10000

# This line may be too long for Windows CMD so use PowerShell on Windows. Make/unix uses sh so should be OK
t_signature_KAT:
	$(GSK_SETUP) ; ./sigtest -alg rsaEncryption -ed pkcs\
	-pub  \
	-pri  \
	-msg 000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F202122232425262728292A2B2C2D2E2F303132333435363738393A3B3C3D3E3F404142434445464748494A4B4C4D4E4F505152535455565758595A5B5C5D5E5F60616263 \
	-sig 

t_ssha2_128s_KAT_sigf:
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHA2_128s" -ed pkcs \
	-pub 3030300b0609608648016503040314032100823808a4bedc67e5645de3a52f2f680f76d0b7bb298c6394e7ef0d131a2723db \
	-pri 3052020100300b060960864801650304031404408a04bd99b87d754bf8739bdb1063a3a130eaeccdf379579006df47eb04e1e388823808a4bedc67e5645de3a52f2f680f76d0b7bb298c6394e7ef0d131a2723db \
	-msg 000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F202122232425262728292A2B2C2D2E2F303132333435363738393A3B3C3D3E3F404142434445464748494A4B4C4D4E4F505152535455565758595A5B5C5D5E5F60616263 \
	-sigf slh_dsa_sha2_128s_sig.txt

testkem: kemtest$(EXESUFX) t_kemtest t_kemtest_v t_k1024 t_k768 t_ktcb
	$(GSK_SETUP) ; ./kemtest -?
#  t_sshake128s - temporary disable
testsig: sigtest$(EXESUFX) t_sigtest_v t_srsa t_srsa_tcb t_srsa_fips t_sdsa44 t_sdsa65 t_ssha2_128s_KAT_sigf
	$(GSK_SETUP) ; ./sigtest -?

tests: testkem tests_all_kyber testsig
	@echo PQC tests complete   

tests_all_kyber: kemtest$(EXESUFX)
	$(GSK_SETUP) ; ./kemtest -alg "MLKEM512" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./kemtest -alg "MLKEM768" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./kemtest -alg "MLKEM1024" $(TEST_FLAGS)

tests_all_dilithium: sigtest$(EXESUFX)
	$(GSK_SETUP) ; ./sigtest -alg "ML_DSA_44" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "ML_DSA_65" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "ML_DSA_87" $(TEST_FLAGS)

tests_all_sphincs: sigtest$(EXESUFX)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHA2_128s" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHA2_128f" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHA2_192s" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHA2_192f" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHA2_256s" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHA2_256f" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHAKE_128s" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHAKE_128f" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHAKE_192s" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHAKE_192f" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHAKE_256s" $(TEST_FLAGS)
	$(GSK_SETUP) ; ./sigtest -alg "SLH_DSA_SHAKE_256f" $(TEST_FLAGS)

$(OBJD):
	mkdir $@

kemtest$(EXESUFX): $(OBJD)/kemtest$(OBJSUFX)
	$(LD) $(LDFLAGS) $^ $(ICCPKG_LIBS) $(SYSLIBS)

sigtest$(EXESUFX): $(OBJD)/sigtest$(OBJSUFX) $(OBJD)/icc_loader$(OBJSUFX)
	$(LD) $(LDFLAGS) $^ $(ICCPKG_LIBS) $(SYSLIBS)

$(OBJD)/kemtest$(OBJSUFX): kemtest.c makefile $(OBJD)
	$(CC) $(DilKyb_CFLAGS) $< $(OUT)$@

$(OBJD)/sigtest$(OBJSUFX): sigtest.c $(ICC_ROOT)/icc_test/icc_loader.h makefile $(OBJD)
	$(CC) $(DilKyb_CFLAGS) -I$(ICC_ROOT)/icc_test $< $(OUT)$@

$(OBJD)/icc_loader$(OBJSUFX): $(ICC_ROOT)/icc_test/icc_loader.c $(ICC_ROOT)/icc_test/icc_loader.h makefile $(OBJD)
	$(CC) $(DilKyb_CFLAGS) -I$(ICC_ROOT)/icc_test $< $(OUT)$@

jkemtest$(EXESUFX): $(OBJD)/jkemtest$(OBJSUFX)
	$(LD) $(LDFLAGS) $^ $(JCCPKG_LIBS) $(SYSLIBS)

jsigtest$(EXESUFX): $(OBJD)/jsigtest$(OBJSUFX) $(OBJD)/icc_loader$(OBJSUFX)
	$(LD) $(LDFLAGS) $^ $(JCCPKG_LIBS) $(SYSLIBS)

$(OBJD)/jkemtest$(OBJSUFX): kemtest.c makefile $(OBJD)
	$(CC) $(DilKyb_CFLAGS) -I $(JGSK_SDK)/inc -D JGSK_WRAP $< $(OUT)$@

$(OBJD)/jsigtest$(OBJSUFX): sigtest.c makefile $(OBJD)
	$(CC) $(DilKyb_CFLAGS) -I $(JGSK_SDK)/inc -D JGSK_WRAP $< $(OUT)$@

ikemtest$(EXESUFX): $(OBJD)/ikemtest$(OBJSUFX)
	$(LD) $(LDFLAGS) $^ $(ICKCPKG_LIBS) $(SYSLIBS)

isigtest$(EXESUFX): $(OBJD)/isigtest$(OBJSUFX) $(OBJD)/icc_loader$(OBJSUFX)
	$(LD) $(LDFLAGS) $^ $(ICKCPKG_LIBS) $(SYSLIBS)

$(OBJD)/ikemtest$(OBJSUFX): kemtest.c makefile $(OBJD)
	$(CC) $(DilKyb_CFLAGS) -I $(GSK_SDK)/inc -D ICKC_WRAP $< $(OUT)$@

$(OBJD)/isigtest$(OBJSUFX): sigtest.c makefile $(OBJD)
	$(CC) $(DilKyb_CFLAGS) -I $(GSK_SDK)/inc -D ICKC_WRAP $< $(OUT)$@


clean:
	-$(RM) -rf $(OBJD)
	-$(RM) kemtest$(EXESUFX) sigtest$(EXESUFX) *.ilk *.pdb

